<form method="post" action="/Home/SearchTrain">

    <div class="column radio">
        <div>
            <input name="flight_way"  type="radio" id="rdoRoundtrip" checked value="2" />

            <label for="rdoRoundtrip"><span><span></span></span>Round Trip</label>
        </div>
        <div>
            <input name="flight_way"  type="radio" value="1" id="rdoOneway" />

            <label for="rdoOneway"><span><span></span></span>One Way</label>
        </div>
    </div>
    <div class="col3 grid grid2">
        <div class="flex labelcol ">
            <div class="autocomplete-wrapper">
                <input name="flight_fromtrain"   type="text" placeholder="Origin" id="flight_fromtrain"
                       onchange="checkdata();" onclick="this.select();"
                       class="autocomplete_from autocomplete_from_new location">

            </div>
            <div class="autocomplete-results"></div>
            <div class="autocomplete-wrapper autowrp">
                <input name="flight_totrain"   type="text" placeholder="Destination" id="flight_totrain"
                       onchange="checkdata1();" onclick="this.select();"
                       class="autocomplete_to autocomplete_from_to location1">
            </div>

        </div>
        <div class="flex labelcol">
            <input type="text" id="flight_from_date"   name="flight_from_date" placeholder="DD-MM-YYYY" required="">
            <input type="text" id="flight_to_date"   name="flight_to_date" placeholder="DD-MM-YYYY" required="">
        </div>

        <div class="flex labelcol">
            <input name="Name" type="text"  placeholder="Name" id="txtname" class="">
        </div>

        <div class="flex labelcol">
            <input name="Email"  placeholder="Email" id="txtemail" type="email" class="">
        </div>

        <div class="flex labelcol">
            <input name="Phoneno" type="text"  placeholder="Contact" id="txtphone" maxlength="12" class="">
        </div>
        <div class="bottom-section flex" style="gap: 5px;">
            <div class="pax-contents labelcol" style="flex: 1;">
                <div class="ind_srch_subBox prp_popup">
                    <div class="prsn_popup" id="prsn_add">
                        <input type="text" readonly="" name="pass_info" id="pass_info"
                               placeholder="1 Pax" class="ind_inputBox">
                    </div>
                    <div class="person_dropdown" id="prsn_popup" style="display: none;">
                        <ul class="slect_pssngr">
                            <li>
                                <label>Adult &nbsp;<span>(12+ Years)</span></label>
                                <div class="count_pssngr">
                                    <a href="javascript:void(0);">
                                        <em data-field="adult"
                                            data-opt="-"
                                            class="fa fa-minus inc_der"></em>
                                    </a>
                                    <input type="text" style="padding: 0 !important; color: #141414 !important;"
                                           readonly="" value="1"  name="flight_adult" 
                                           id="flight_adult" class="inpt_cout_pssngr">
                                    <a href="javascript:void(0);">
                                        <em data-field="adult"
                                            data-opt="+"
                                            class="fa fa-plus inc_der"></em>
                                    </a>
                                </div>
                            </li>
                            <li>
                                <label style="max-width: 125px; line-height: 1.3;">
                                    Children
                                    &nbsp;<span>(2-11 Years)</span>
                                </label>
                                <div class="count_pssngr">
                                    <a href="javascript:void(0);">
                                        <em data-field="child"
                                            data-opt="-"
                                            class="fa fa-minus inc_der"></em>
                                    </a>
                                    <input type="text" style="padding: 0 !important; color: #141414 !important;"
                                           readonly="" value="0"  name="flight_child" 
                                           id="flight_child" class="inpt_cout_pssngr">
                                    <a href="javascript:void(0);">
                                        <em data-field="child"
                                            data-opt="+"
                                            class="fa fa-plus inc_der"></em>
                                    </a>
                                </div>
                            </li>
                            <li>
                                <label>Infant &nbsp;<span>(0-2 Years)</span></label>
                                <div class="count_pssngr">
                                    <a href="javascript:void(0);">
                                        <em data-field="infant"
                                            data-opt="-"
                                            class="fa fa-minus inc_der"></em>
                                    </a>
                                    <input type="text" style="padding: 0 !important; color: #141414 !important;"
                                           readonly="" value="0"  name="flight_infant" 
                                           id="flight_infant" class="inpt_cout_pssngr">
                                    <a href="javascript:void(0);">
                                        <em data-field="infant"
                                            data-opt="+"
                                            class="fa fa-plus inc_der"></em>
                                    </a>
                                </div>
                            </li>
                        </ul>
                        <div class="clss_done" id="ind_done">
                            <a href="javascript:void(0);" id="prsn_done">Done</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="search_flights">
                <button type="submit" class="search_btn">Search</button>
            </div>
        </div>
    </div>



    </form>

<style>
    .ui-datepicker {
        width: 25em !important;
    }

        .ui-datepicker table {
            width: 100% !important;
            margin: 0 !important;
            font-size: 1em !important;
        }

        .ui-datepicker th,
        .ui-datepicker td {
            padding: 2px !important;
        }
</style>
    <link href="/Content/searchAirport.css" rel="stylesheet" />
    <script src="/scripts/lodash.min.js"></script>
    <script src="/scripts/fuse.min.js"></script>
    <script src="/Scripts/train.js"></script>

