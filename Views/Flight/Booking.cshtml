                </div>

                <!-- ===== RIGHT: Price Summary ===== -->
                <div>
                    <div class="price-box">
                        <div class="flight-recap">
                            <div style="width:60px;height:60px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid #e9ecf0;overflow:hidden;">


                                <img src="@("https://fareschoices.com/Content/airline/fit/" + Model.Flights.Outbound[0].Airline.Code + ".gif")" style="width:52px;height:auto;object-fit:contain;display:block;" />


                            </div>
                            <div>

                                <div class="flight-route" id="summaryRoute">
                                    @Model.Flights.Outbound[0].FromAirport.Code
                                    →
                                    @Model.Flights.Outbound[Model.Flights.Outbound.Count - 1].ToAirport.Code
                                </div>

                                <div class="flight-meta" id="summaryMeta">

                                    @(Model.FlightsSearch.FlightWay == FlightWay.RoundTrip ? "Round Trip" : "One Way")
                                    ·
                                    @Model.Flights.Outbound[0].CabinClass
                                    ·
                                    @(Model.Flights.FlightFare.Adult) Adult@(Model.Flights.FlightFare.Adult > 1 ? "s" : "")

                                    @if (Model.Flights.FlightFare.Child > 0)
                                    {
                                        <text> · @(Model.Flights.FlightFare.Child) Child@(Model.Flights.FlightFare.Child > 1 ? "ren" : "")</text>
                                    }

                                    @if (Model.Flights.FlightFare.Infant > 0)
                                    {
                                        <text> · @(Model.Flights.FlightFare.Infant) Infant@(Model.Flights.FlightFare.Infant > 1 ? "s" : "")</text>
                                    }

                                </div>

                            </div>
                        </div>
