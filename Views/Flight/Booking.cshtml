                                <span>Return</span>
                                <span>
                                    @Model.Flights.Inbound[0].DepartureDate.ToString("dd MMM")
                                    ·
                                    @Model.Flights.Inbound[0].DepartureDate.ToString("hh:mm tt")
                                </span>
                            </div>
                        }


