                Back to results
            </a>*@
        <div class="steps">
            <div class="step done">
                <div class="step-num">✓</div>
                <span class="step-label">Search</span>
            </div>
            <span class="step-sep">›</span>
            <div class="step done">
                <div class="step-num">✓</div>
                <span class="step-label">Review</span>
            </div>
            <span class="step-sep">›</span>
            <div class="step active">
