<div class="page">
    <div class="listing">
        <form method="post" id="booking_frm" name="booking_frm" action="@Url.Content("~/Flight/Payment")">
            <input type="hidden" id="hsearchId" name="hsearchId" value="@(Model.FlightsSearch.SearchId)" />
            <div class="main">
                <!-- ===== LEFT: Forms ===== -->
                <div id="leftCol">

                    <!-- ─── Passenger Details ─── -->
                    <div class="form-card">
                        <h5>
                            <span class="icon">
                                <img src="~/images/Passenger-Details.png"
                                     style="width:18px;height:18px;object-fit:contain;">
                            </span>
                            Passenger Details
                        </h5>

                        <p class="section-sub">
                            Name exactly as it appears on passport or government ID.
                        </p>

                        <!-- Passenger Tabs -->
                        <div class="passenger-tabs">
                            @for (int i = 1; i <= Model.FlightsSearch.Adult; i++)
                            {
                                <button type="button"
                                        class="ptab @(i==1?"active":"")"
                                        onclick="switchPassenger(@(i-1))">
                                    Adult @i
                                </button>
                            }

                            @for (int i = 1; i <= Model.FlightsSearch.Child; i++)
                            {
                                <button type="button"
                                        class="ptab"
                                        onclick="switchPassenger(@(Model.FlightsSearch.Adult+i-1))">
                                    Child @i
                                </button>
                            }

                            @for (int i = 1; i <= Model.FlightsSearch.Infant; i++)
                            {
                                <button type="button"
                                        class="ptab"
                                        onclick="switchPassenger(@(Model.FlightsSearch.Adult+Model.FlightsSearch.Child+i-1))">
                                    Infant @i
                                </button>
                            }
                        </div>

