@model Viman.Models.FlightsBooking
@using Viman.Models
@{
    ViewBag.Title = "Booking";
    Layout = "~/Views/Shared/_Layoutinner.cshtml";
    ViewBag.WebsiteURL = Common.WebsiteURL;
    ViewBag.StaticURL = Common.StaticURL;
    ViewBag.Currency = Common.Currency;
    FlightsSearch flightSearch = ViewBag.flightSearch;
    Flights flights = ViewBag.flights;

    int mm = 0, nn = 0, pass = 0;

    <style>
        .form-card {
            background: #fff;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 5px 18px rgba(0,0,0,.08);
        }

            .form-card h5 {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 22px;
                font-weight: 600;
                margin-bottom: 6px;
            }

        .section-sub {
            color: #777;
            margin-bottom: 20px;
        }

        .passenger-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 25px;
        }

        .ptab {
            border: none;
            background: #f3f4f8;
            color: #333;
            padding: 10px 22px;
            border-radius: 30px;
            cursor: pointer;
            transition: .3s;
            font-weight: 500;
        }

            .ptab:hover {
                background: #0d6efd;
                color: #fff;
            }

            .ptab.active {
                background: #0d6efd;
                color: #fff;
            }

        .passenger-panel {
            display: none;
        }

            .passenger-panel.active {
                display: block;
            }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 18px;
            margin-bottom: 18px;
        }

            .form-row.three {
                grid-template-columns: repeat(3,1fr);
            }

        .form-group {
            display: flex;
            flex-direction: column;
        }

            .form-group label {
                font-size: 14px;
                font-weight: 600;
                margin-bottom: 7px;
            }

        .form-control,
        .form-select {
            height: 48px;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 0 14px;
            font-size: 15px;
            transition: .3s;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #0d6efd;
                outline: none;
                box-shadow: 0 0 0 3px rgba(13,110,253,.15);
            }

        .gender-box {
            display: flex;
            align-items: center;
            gap: 25px;
            height: 48px;
        }

            .gender-box label {
                margin: 0;
                font-weight: 500;
            }

            .gender-box input {
                margin-right: 6px;
            }

        @@media(max-width:992px) {

            .form-row {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:600px) {

            .form-row,
            .form-row.three {
                grid-template-columns: 1fr;
            }

            .passenger-tabs {
                overflow: auto;
                white-space: nowrap;
            }

            .ptab {
                flex: none;
            }
        }
    </style>


    double fare = 0;
    string flightid = "";
    foreach (FlightsSegment outboundArr in flights.Outbound)
    {

        fare = Convert.ToDouble(flights.TotalCost.ToString("0.00"));

        flightid = flights.FlightId;

    }
    if (flightSearch.FlightWay == FlightWay.RoundTrip)
    {

        foreach (FlightsSegment inboundArr in flights.Inbound)
        {

            fare = Convert.ToDouble(flights.TotalCost.ToString("0.00"));

            flightid = flights.FlightId;

        }


    }



}

