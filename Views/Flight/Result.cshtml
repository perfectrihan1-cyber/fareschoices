            function changeFilter() {
                var fway = $('input[name=flight_way]:checked').val();

                // Get Stop Filters
                var stop_0 = $('input[name="stop_0"]:checked').val();
                var stop_1 = $('input[name="stop_1"]:checked').val();
                var stop_2 = $('input[name="stop_2"]:checked').val();

                // Get Departure Time Filters
                var dep_00 = $('input[name="dep_00"]:checked').val();
                var dep_06 = $('input[name="dep_06"]:checked').val();
                var dep_12 = $('input[name="dep_12"]:checked').val();
                var dep_18 = $('input[name="dep_18"]:checked').val();

                // Get Return Time Filters
                var ret_00 = $('input[name="ret_00"]:checked').val();
                var ret_06 = $('input[name="ret_06"]:checked').val();
                var ret_12 = $('input[name="ret_12"]:checked').val();
                var ret_18 = $('input[name="ret_18"]:checked').val();

                // Get Min/Max Price
                var min_p = parseFloat($("#min_price").val());
                var max_p = parseFloat($("#max_price").val());

                var AllCnt = $("#hAllCnt").val();
                for (var i = 1; i <= AllCnt; i++) {
                    var $flight = $(".flight_mainVal" + i);

                    // Flight Data
                    var flightStop = $flight.data("stop");
                    var flightPrice = parseFloat($flight.data("price"));
                    var flightDepTime = parseInt($("#hdptTime_" + i).val());
                    var flightRetTime = parseInt($("#hretTime_" + i).val()); // May be undefined/NaN for one-way

                    var airlineCode = $flight.data("airline");
                    var isAirlineChecked = true;
                    if($('.airline_flt').length > 0) {
                         // If any airline filter exists
                         var $airlineChk = $('.airline_flt[value="' + airlineCode + '"]');
                         if($airlineChk.length > 0 && !$airlineChk.is(':checked')) {
                             isAirlineChecked = false;
                         }
                         // Also check "new_airline_flt" if that's a thing (lines 386)
                         var $newAirlineChk = $('.new_airline_flt[data-airline="' + airlineCode + '"]');
                         if($newAirlineChk.length > 0 && !$newAirlineChk.is(':checked')) {
                             isAirlineChecked = false;
                         }
                    }

                    // Combined Check
                    var show = true;

                    // 1. Stops
                    if (!checkStop(stop_0, stop_1, stop_2, flightStop)) show = false;

                    // 2. Dep Time
                    if (show && !checkDep(dep_00, dep_06, dep_12, dep_18, flightDepTime)) show = false;

                    // 3. Ret Time (Only if roundtrip and ret filters exist/checked)
                    // checkDep function logic can be reused for return time if we pass return time vars
                    if (show && fway == "2") {
                         // Reuse checkDep logic for return times
                         if (!checkDep(ret_00, ret_06, ret_12, ret_18, flightRetTime)) show = false;
                    }

                    // 4. Price
                    if (show) {
                        if (flightPrice < min_p || flightPrice > max_p) show = false;
                    }

                    // 5. Airline
                    if (show && !isAirlineChecked) show = false;


                    if (show) {
                        $flight.show();
                    } else {
                        $flight.hide();
                    }
                }
            }

