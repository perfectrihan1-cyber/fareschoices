@model Viman.Models.FlightsResult
@using Viman.Models

@{
    ViewBag.Title = "Search";
    ViewBag.PageName = "flight";
    Layout = "~/Views/Shared/_Layoutinner.cshtml";
}


<link href="~/css1/flight_result.css" rel="stylesheet" />
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Trip Type Dropdown
        const tripTypeBtn = document.getElementById("tripTypeBtn");
        const tripTypeDropdown = document.getElementById("tripTypeDropdown");

        if (tripTypeBtn && tripTypeDropdown) {

            tripTypeBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                tripTypeDropdown.classList.toggle("open");
            });

            tripTypeDropdown.addEventListener("click", function (e) {
                e.stopPropagation();
            });
        }

        // Traveller Dropdown
        const travellerBtn = document.getElementById("travellerBtn");
        const travellerDropdown = document.getElementById("travellerDropdown");

        if (travellerBtn && travellerDropdown) {

            travellerBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                travellerDropdown.classList.toggle("open");
            });

            travellerDropdown.addEventListener("click", function (e) {
                e.stopPropagation();
            });
        }

        // Close dropdowns when clicking outside
        document.addEventListener("click", function () {

            if (tripTypeDropdown) {
                tripTypeDropdown.classList.remove("open");
            }

            if (travellerDropdown) {
                travellerDropdown.classList.remove("open");
            }

        });

    });   
</script>
<style>

    .priceFilter .ui-widget-header {
        background: #526BF1 !important;
        
    }

    .filter {
        width: 100%;
    }
    
    .sky-search-wrap {
        display: flex;
        align-items: flex-end;
    }

    .sky-search-btn {
        width: 100%;
        height: 62px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
    }
</style>



    @if (@Model.FlightsList != null && @Model.FlightsList.Count > 0)
