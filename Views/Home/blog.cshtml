
@{
    ViewBag.Title = "blog";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section metatags{






}

<div class="container BannerBg">
    <div class="innervootbg">
        <div class="row">
            <div class="column">
                <h1>Blogs - Fares Choices</h1>
                @{Html.RenderPartial("~/Views/Shared/_SearchEngine.cshtml");}

            </div>
        </div>
    </div>
</div>

<div class="container blogpage">
    <div class="row">
        <div class="column">
            <div class="grid grid2">
                <div class="search-column flex">
                    <input type="search" placeholder="Search...">
                    <button class="button"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
                <div></div>
                <div>
                    <div class="pagination1" style="display: flex;">
                        <button id="prev-btn" disabled=""><i class="fa-solid fa-angles-left"></i></button>
                        <span id="page-number"><button class="active">1</button></span>
                        <button id="next-btn" disabled=""><i class="fa-solid fa-angles-right"></i></button>
                    </div>
                </div>
            </div>
            <br>
            <div class="product-container grid grid2">
            </div>
            <script src="/css/blogs.js"></script>
        </div>
    </div>
</div>

